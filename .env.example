# ─────────────────────────────────────────────────────────
# PhishTriage Pro — API Keys
# Copy this file to .env and fill in your keys.
# ALL FOUR ARE FREE. No credit card needed for any of them.
# Tool works without any key — local heuristics always run.
# ─────────────────────────────────────────────────────────

# 1. urlscan.io — Free 5000 scans/month
# Get key: https://urlscan.io/user/signup
URLSCAN_API_KEY=

# 2. AbuseIPDB — Free 1000 checks/day
# Get key: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=

# 3. AlienVault OTX — FREE unlimited
# Get key: https://otx.alienvault.com → Settings → API Key
OTX_API_KEY=

# 4. Google Safe Browsing — Free 10,000 checks/day
# Get key: https://console.cloud.google.com → Enable Safe Browsing API
GOOGLE_SAFE_BROWSING_KEY=
